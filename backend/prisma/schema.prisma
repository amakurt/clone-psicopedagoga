generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String?
  role          String   @default("SECRETARIA")
  active        Boolean  @default(true)
  avatarUrl     String?
  phone         String?
  registration  String?
  bio           String?
  clinicName    String?
  clinicAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prontuarios        Prontuario[]
  anamneses          Anamnese[]
  laudos             Laudo[]
  sessoes            Sessao[]
  comunicacoes       Comunicacao[]
  encaminhamentosDe  Encaminhamento[] @relation("EncaminhamentoDe")
  encaminhamentosPara Encaminhamento[] @relation("EncaminhamentoPara")
  notifications      Notification[]
  documents          Document[]
  appointments       Appointment[]
  protocolEvaluations ProtocolEvaluation[]
  interventionPlans  InterventionPlan[]
  socialAccounts     SocialAccount[]
}

model Paciente {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  cpf           String?
  rg            String?
  birthDate     String?
  age           String?
  initials      String?
  color         String?
  avatarUrl     String?
  status        String   @default("ATIVO")
  grade         String?
  notes         String?
  active        Boolean  @default(true)
  accessCode    String?
  cep           String?
  street        String?
  neighborhood  String?
  number        String?
  complement    String?
  responsibleId String?
  schoolId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  responsible       Responsible?  @relation(fields: [responsibleId], references: [id])
  school            School?       @relation(fields: [schoolId], references: [id])
  prontuarios       Prontuario[]
  anamneses         Anamnese[]
  sessoes           Sessao[]
  laudos            Laudo[]
  encaminhamentos   Encaminhamento[]
  financeiro        FinanceiroSessao[]
  documents         Document[]
  appointments      Appointment[]
  sessionRecords    SessionRecord[]
  protocolEvaluations ProtocolEvaluation[]
  interventionPlans InterventionPlan[]
  chatMessages      ChatMessage[]
}

model Responsible {
  id           String   @id @default(cuid())
  name         String
  birthDate    String?
  relationship String
  cpf          String?
  rg           String?
  phones       String?
  email        String?
  avatarUrl    String?
  cep          String?
  street       String?
  neighborhood String?
  number       String?
  complement   String?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patients Paciente[]
}

model School {
  id           String   @id @default(cuid())
  name         String
  levels       String?
  cep          String?
  street       String?
  neighborhood String?
  number       String?
  complement   String?
  city         String?
  state        String?
  phone        String?
  contactName  String?
  contactEmail String?
  patientCount Int      @default(0)
  status       String   @default("Ativa")
  imageUrl     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patients Paciente[]
}

model Prontuario {
  id         String   @id @default(cuid())
  titulo     String
  conteudo   String
  pacienteId String
  autorId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  autor    User     @relation(fields: [autorId], references: [id])
}

model Anamnese {
  id                     String @id @default(cuid())
  pacienteId             String
  autorId                String
  status                 String @default("PENDENTE")
  turno                  String?
  telefoneEscola         String?
  enderecoEscola         String?
  escolaCep              String?
  escolaRua              String?
  escolaBairro           String?
  escolaNumero           String?
  escolaComplemento      String?
  escolaCidade           String?
  escolaEstado           String?
  indicacaoTratamento    String?
  diagnostico            String?
  profissaoPai           String?
  idadePai               String?
  escolaridadePai        String?
  profissaoMae           String?
  idadeMae               String?
  escolaridadeMae        String?
  queixaPrincipal        String?
  historiaQueixa         String?
  constelacaoFamiliar    String?
  gestacao               String?
  parto                  String?
  desenvolvimentoMotor   String?
  desenvolvimentoLinguagem String?
  sono                   String?
  alimentacao            String?
  medicacoes             String?
  tratamentosAnteriores  String?
  historicoEscolar       String?
  dificuldadesAprendizado String?
  interacaoSocial        String?
  historicoFamiliar      String?
  observacoesComportamentais String?
  historico              String?
  desenvolvimento        String?
  comportamento          String?
  escolaridade           String?
  familial               String?
  observacoes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  autor    User     @relation(fields: [autorId], references: [id])
}

model Sessao {
  id              String   @id @default(cuid())
  pacienteId      String
  psicopedagogoId String
  date            DateTime
  duration        Int?
  tipo            String?
  status          String   @default("AGENDADA")
  valor           Float?
  observacoes     String?
  objective       String?
  summary         String?
  activities      String?
  instruments     String?
  sharedWithGuardian Boolean @default(false)
  startTime       String?
  endTime         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paciente      Paciente @relation(fields: [pacienteId], references: [id])
  psicopedagogo User     @relation(fields: [psicopedagogoId], references: [id])
  financeiro    FinanceiroSessao[]
}

model Laudo {
  id         String   @id @default(cuid())
  titulo     String
  type       String   @default("LAUDO")
  content    String
  status     String   @default("RASCUNHO")
  pacienteId String
  autorId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  autor    User     @relation(fields: [autorId], references: [id])
}

model Encaminhamento {
  id          String   @id @default(cuid())
  pacienteId  String
  deUserId    String
  paraUserId  String?
  motivo      String
  resposta    String?
  status      String   @default("PENDENTE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  deUser   User     @relation("EncaminhamentoDe", fields: [deUserId], references: [id])
  paraUser User?    @relation("EncaminhamentoPara", fields: [paraUserId], references: [id])
}

model Comunicacao {
  id        String   @id @default(cuid())
  titulo    String
  mensagem  String
  tipo      String   @default("AVISO")
  autorId   String?
  createdAt DateTime @default(now())

  autor User? @relation(fields: [autorId], references: [id])
}

model FinanceiroSessao {
  id            String   @id @default(cuid())
  pacienteId    String
  sessaoId      String?
  valor         Float
  status        String   @default("PENDENTE")
  tipo          String?
  description   String?
  category      String?
  dataPagamento DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  sessao   Sessao?  @relation(fields: [sessaoId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("message")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Document {
  id               String   @id @default(cuid())
  name             String
  pacienteId       String?
  size             String?
  status           String   @default("RASCUNHO")
  category         String   @default("GERAL")
  uploadedBy       String   @default("professional")
  fileUrl          String?
  isShared         Boolean  @default(false)
  signedAt         String?
  guardianSignedAt String?
  autorId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  autor    User?     @relation(fields: [autorId], references: [id])
}

model Appointment {
  id          String   @id @default(cuid())
  pacienteId  String
  patientName String
  date        String
  startTime   String
  endTime     String
  type        String   @default("OUTRO")
  status      String   @default("PENDENTE")
  notes       String?
  color       String?
  autorId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  autor    User?     @relation(fields: [autorId], references: [id])
}

model LibraryResource {
  id          String   @id @default(cuid())
  name        String
  description String
  ageRange    String?
  category    String
  icon        String?
  fileUrl     String?
  fileName    String?
  fileSize    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id             String   @id @default(cuid())
  patientName    String
  patientId      String?
  date           String
  value          String
  status         String   @default("PENDENTE")
  type           String   @default("RECEITA")
  description    String?
  category       String?
  avatarUrl      String?
  paymentUrl     String?
  paymentMethod  String?
  professionalId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SessionRecord {
  id                 String   @id @default(cuid())
  pacienteId         String
  professionalId     String?
  professionalName   String?
  sessionNumber      Int?
  date               String
  objective          String?
  summary            String
  activities         String
  instruments        String?
  observations       String
  sharedWithGuardian Boolean  @default(false)
  startTime          String?
  endTime            String?
  focus              Int?
  engagement         Int?
  skillProgress      Int?
  behavior           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
}

model ProtocolEvaluation {
  id             String   @id @default(cuid())
  pacienteId     String
  professionalId String
  date           String
  evaluations    String
  totalEvaluations Int  @default(0)
  averageScore   Float  @default(0)
  maxScore       Float  @default(0)
  minScore       Float  @default(0)
  createdAt      DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  profissional User @relation(fields: [professionalId], references: [id])
}

model InterventionPlan {
  id             String   @id @default(cuid())
  pacienteId     String
  professionalId String
  date           String
  step1          String?
  step2          String?
  step3          String?
  sessionCount   Int      @default(0)
  sessionValue   String?
  totalValue     String?
  frequency      String?
  duration       String?
  status         String   @default("RASCUNHO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  profissional User @relation(fields: [professionalId], references: [id])
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  senderName String
  message    String
  pacienteId String
  createdAt  DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
}

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
}
