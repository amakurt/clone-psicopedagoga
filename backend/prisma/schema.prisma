generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("TRIAL") // TRIAL | BASICO | PRO
  status      String   @default("ATIVO") // ATIVO | BLOQUEADO
  trialEndsAt DateTime?
  logoUrl     String?
  colors      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  subscription Subscription?

  pacientes        Paciente[]
  signatures       Signature[]
  whatsappConfigs  WhatsAppConfig[]
  whatsappLogs     WhatsAppLog[]
  responsibles     Responsible[]
  documentRequests DocumentRequest[]
  schools          School[]
  prontuarios      Prontuario[]
  anamneses        Anamnese[]
  sessoes          Sessao[]
  laudos           Laudo[]
  encaminhamentos  Encaminhamento[]
  comunicacoes     Comunicacao[]
  financeiro       FinanceiroSessao[]
  notifications    Notification[]
  documents        Document[]
  appointments     Appointment[]
  libraryResources LibraryResource[]
  transactions     Transaction[]
  sessionRecords   SessionRecord[]
  abaAssessments   ABAAssessment[]
  abaPrograms      ABAProgram[]
  abaDataPoints    ABADataPoint[]
  protocolEvaluations ProtocolEvaluation[]
  interventionPlans   InterventionPlan[]
  chatMessages        ChatMessage[]
  sessionDiaries      SessionDiary[]
  frequencySheets     FrequencySheet[]
  interventionDocuments InterventionDocument[]
  consentLogs          ConsentLog[]
  nfse                 Nfse[]
  waitingRoom          WaitingRoom[]
  availabilities       Availability[]
}

model Membership {
  id        String   @id @default(cuid())
  tenantId String @default("")
  userId    String
  role      String   @default("SECRETARIA")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String?
  role          String   @default("SECRETARIA")
  active        Boolean  @default(true)
  avatarUrl     String?
  phone         String?
  phoneIsWhatsApp Boolean @default(false)
  registration  String?
  bio           String?
  clinicName    String?
  clinicAddress String?
  permissions   String?
  pixKey        String?
  pixKeyType    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships        Membership[]
  prontuarios        Prontuario[]
  anamneses          Anamnese[]
  laudos             Laudo[]
  sessoes            Sessao[]
  comunicacoes       Comunicacao[]
  encaminhamentosDe  Encaminhamento[] @relation("EncaminhamentoDe")
  encaminhamentosPara Encaminhamento[] @relation("EncaminhamentoPara")
  notifications      Notification[]
  documents          Document[]
  appointments       Appointment[]
  protocolEvaluations ProtocolEvaluation[]
  interventionPlans  InterventionPlan[]
  socialAccounts     SocialAccount[]
  signatures         Signature[]
  abaAssessments     ABAAssessment[]
  abaPrograms        ABAProgram[]
  nfseIssued         Nfse[]
  verificationCodes  VerificationCode[]
  documentRequests   DocumentRequest[]
  availabilities     Availability[]
}

model Availability {
  id        String   @id @default(cuid())
  tenantId String @default("")
  userId    String
  dayOfWeek Int      // 0=domingo ... 6=sábado
  startTime String   // "09:00"
  endTime   String   // "17:00"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  type      String   // ACCOUNT_ACTIVATION | PASSWORD_RESET
  channel   String   // EMAIL | WHATSAPP
  codeHash  String
  tokenHash String?
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Paciente {
  id            String   @id @default(cuid())
  tenantId String @default("")
  name          String
  email         String?
  phone         String?
  cpf           String?
  rg            String?
  birthDate     String?
  age           String?
  initials      String?
  color         String?
  avatarUrl     String?
  status        String   @default("ATIVO")
  grade         String?
  notes         String?
  active        Boolean  @default(true)
  accessCode    String?
  cep           String?
  street        String?
  neighborhood  String?
  number        String?
  complement    String?
  city          String?
  state         String?
  phoneIsWhatsApp Boolean @default(false)
  responsibleId String?
  schoolId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  responsible       Responsible?  @relation(fields: [responsibleId], references: [id])
  school            School?       @relation(fields: [schoolId], references: [id])
  prontuarios       Prontuario[]
  anamneses         Anamnese[]
  sessoes           Sessao[]
  laudos            Laudo[]
  encaminhamentos   Encaminhamento[]
  financeiro        FinanceiroSessao[]
  documents         Document[]
  appointments      Appointment[]
  sessionRecords    SessionRecord[]
  protocolEvaluations ProtocolEvaluation[]
  interventionPlans InterventionPlan[]
  chatMessages      ChatMessage[]
  sessionDiaries    SessionDiary[]
  frequencySheets   FrequencySheet[]
  interventionDocuments InterventionDocument[]
  whatsappLogs         WhatsAppLog[]
  abaAssessments       ABAAssessment[]
  abaPrograms          ABAProgram[]
  documentRequests     DocumentRequest[]
  nfse                 Nfse[]
  waitingRoom          WaitingRoom[]
  consentLogs          ConsentLog[]

  @@index([tenantId])
}

model Signature {
  id           String   @id @default(cuid())
  tenantId String @default("")
  userId       String
  imageBase64  String
  documentType String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model WhatsAppConfig {
  id              String   @id @default(cuid())
  tenantId String @default("")
  apiUrl          String
  token           String
  phoneNumberId   String?
  autoSendReminders Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  tenantId String @default("")
  patientId String
  phone     String
  message   String
  status    String   @default("SENT")
  sentBy    String
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  paciente Paciente? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
}

model Responsible {
  id           String   @id @default(cuid())
  tenantId String @default("")
  name         String
  birthDate    String?
  relationship String
  cpf          String?
  rg           String?
  phones       String?
  phoneIsWhatsApp Boolean @default(false)
  email        String?
  avatarUrl    String?
  cep          String?
  street       String?
  neighborhood String?
  number       String?
  complement   String?
  city         String?
  state        String?
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  patients         Paciente[]
  documentRequests DocumentRequest[]

  @@index([tenantId])
}

model DocumentRequest {
  id             String    @id @default(cuid())
  tenantId String @default("")
  professionalId String
  patientId      String?
  responsibleId  String?
  title          String
  description    String?
  templateJson   String
  token          String    @unique
  status         String    @default("PENDENTE") // PENDENTE | RESPONDIDO | EXPIRADO | CANCELADO
  dueDate        DateTime?
  sentVia        String?   // EMAIL | WHATSAPP | LINK
  submittedAt    DateTime?
  answersJson    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  professional User         @relation(fields: [professionalId], references: [id])
  paciente     Paciente?    @relation(fields: [patientId], references: [id])
  responsible  Responsible? @relation(fields: [responsibleId], references: [id])

  @@index([tenantId])
}

model School {
  id           String   @id @default(cuid())
  tenantId String @default("")
  name         String
  levels       String?
  cep          String?
  street       String?
  neighborhood String?
  number       String?
  complement   String?
  city         String?
  state        String?
  phone        String?
  contactName  String?
  contactEmail String?
  patientCount Int      @default(0)
  status       String   @default("Ativa")
  imageUrl     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  patients Paciente[]

  @@index([tenantId])
}

model Prontuario {
  id         String   @id @default(cuid())
  tenantId String @default("")
  titulo     String
  conteudo   String
  pacienteId String
  autorId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  autor    User     @relation(fields: [autorId], references: [id])

  @@index([tenantId])
}

model Anamnese {
  id                     String @id @default(cuid())
  tenantId String @default("")
  pacienteId             String
  autorId                String
  status                 String @default("PENDENTE")
  turno                  String?
  telefoneEscola         String?
  enderecoEscola         String?
  escolaCep              String?
  escolaRua              String?
  escolaBairro           String?
  escolaNumero           String?
  escolaComplemento      String?
  escolaCidade           String?
  escolaEstado           String?
  indicacaoTratamento    String?
  diagnostico            String?
  profissaoPai           String?
  idadePai               String?
  escolaridadePai        String?
  profissaoMae           String?
  idadeMae               String?
  escolaridadeMae        String?
  queixaPrincipal        String?
  historiaQueixa         String?
  constelacaoFamiliar    String?
  gestacao               String?
  parto                  String?
  desenvolvimentoMotor   String?
  desenvolvimentoLinguagem String?
  sono                   String?
  alimentacao            String?
  medicacoes             String?
  tratamentosAnteriores  String?
  historicoEscolar       String?
  dificuldadesAprendizado String?
  interacaoSocial        String?
  historicoFamiliar      String?
  observacoesComportamentais String?
  historico              String?
  desenvolvimento        String?
  comportamento          String?
  escolaridade           String?
  familial               String?
  observacoes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  autor    User     @relation(fields: [autorId], references: [id])

  @@index([tenantId])
}

model Sessao {
  id              String   @id @default(cuid())
  tenantId String @default("")
  pacienteId      String
  psicopedagogoId String
  date            DateTime
  duration        Int?
  tipo            String?
  status          String   @default("AGENDADA")
  valor           Float?
  observacoes     String?
  objective       String?
  summary         String?
  activities      String?
  instruments     String?
  sharedWithGuardian Boolean @default(false)
  startTime       String?
  endTime         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  paciente      Paciente @relation(fields: [pacienteId], references: [id])
  psicopedagogo User     @relation(fields: [psicopedagogoId], references: [id])
  financeiro    FinanceiroSessao[]

  @@index([tenantId])
}

model Laudo {
  id         String   @id @default(cuid())
  tenantId String @default("")
  titulo     String
  type       String   @default("LAUDO")
  content    String
  status     String   @default("RASCUNHO")
  pacienteId String
  autorId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  autor    User     @relation(fields: [autorId], references: [id])

  @@index([tenantId])
}

model Encaminhamento {
  id          String   @id @default(cuid())
  tenantId String @default("")
  pacienteId  String
  deUserId    String
  paraUserId  String?
  motivo      String
  resposta    String?
  status      String   @default("PENDENTE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  deUser   User     @relation("EncaminhamentoDe", fields: [deUserId], references: [id])
  paraUser User?    @relation("EncaminhamentoPara", fields: [paraUserId], references: [id])

  @@index([tenantId])
}

model Comunicacao {
  id        String   @id @default(cuid())
  tenantId String @default("")
  titulo    String
  mensagem  String
  tipo      String   @default("AVISO")
  autorId   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  autor User?  @relation(fields: [autorId], references: [id])

  @@index([tenantId])
}

model FinanceiroSessao {
  id            String   @id @default(cuid())
  tenantId String @default("")
  pacienteId    String
  sessaoId      String?
  valor         Float
  status        String   @default("PENDENTE")
  tipo          String?
  description   String?
  category      String?
  dataPagamento DateTime?
  paymentMethod String?
  pixCopiaECola String?
  pixKey        String?
  pixKeyType    String?
  chargeShared  Boolean  @default(false)
  payConfirmedByGuardian Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])
  sessao   Sessao?  @relation(fields: [sessaoId], references: [id])

  @@index([tenantId])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId String @default("")
  userId    String
  title     String
  message   String
  type      String   @default("message")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, read])
}

model Document {
  id               String   @id @default(cuid())
  tenantId String @default("")
  name             String
  pacienteId       String?
  size             String?
  status           String   @default("RASCUNHO")
  category         String   @default("GERAL")
  uploadedBy       String   @default("professional")
  fileUrl          String?
  isShared         Boolean  @default(false)
  approvalFeedback String?
  signedAt         String?
  guardianSignedAt String?
  autorId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  autor    User?     @relation(fields: [autorId], references: [id])

  @@index([tenantId])
}

model Appointment {
  id          String   @id @default(cuid())
  tenantId String @default("")
  pacienteId  String
  patientName String
  date        String
  startTime   String
  endTime     String
  type        String   @default("OUTRO")
  status      String   @default("PENDENTE")
  notes       String?
  color       String?
  autorId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  autor    User?     @relation(fields: [autorId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
}

model LibraryResource {
  id          String   @id @default(cuid())
  tenantId String @default("")
  name        String
  description String
  ageRange    String?
  category    String
  icon        String?
  fileUrl     String?
  fileName    String?
  fileSize    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Transaction {
  id             String   @id @default(cuid())
  tenantId String @default("")
  patientName    String
  patientId      String?
  date           String
  value          String
  status         String   @default("PENDENTE")
  type           String   @default("RECEITA")
  description    String?
  category       String?
  avatarUrl      String?
  paymentUrl     String?
  paymentMethod  String?
  professionalId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model SessionRecord {
  id                 String   @id @default(cuid())
  tenantId String @default("")
  pacienteId         String
  professionalId     String?
  professionalName   String?
  sessionNumber      Int?
  date               String
  objective          String?
  summary            String
  activities         String
  instruments        String?
  observations       String
  sharedWithGuardian Boolean  @default(false)
  startTime          String?
  endTime            String?
  focus              Int?
  engagement         Int?
  skillProgress      Int?
  behavior           Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([tenantId])
}

model ABAAssessment {
  id             String   @id @default(cuid())
  tenantId String @default("")
  patientId      String
  professionalId String
  protocolType   String
  evaluations    String
  totalScore     Float?
  domainScores   String?
  notes          String?
  assessedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  paciente     Paciente @relation(fields: [patientId], references: [id])
  professional User     @relation(fields: [professionalId], references: [id])

  @@index([tenantId])
}

model ABAProgram {
  id                     String   @id @default(cuid())
  tenantId String @default("")
  patientId              String
  professionalId         String
  targetBehavior         String
  interventionStrategy   String
  dataCollectionMethod   String?
  status                 String   @default("ATIVO")
  startDate              DateTime @default(now())
  endDate                DateTime?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  paciente     Paciente      @relation(fields: [patientId], references: [id])
  professional User          @relation(fields: [professionalId], references: [id])
  dataPoints   ABADataPoint[]

  @@index([tenantId])
}

model ABADataPoint {
  id        String   @id @default(cuid())
  tenantId String @default("")
  programId String
  date      DateTime @default(now())
  value     Float
  note      String?
  createdAt DateTime @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  program ABAProgram @relation(fields: [programId], references: [id])

  @@index([tenantId])
}

model ProtocolEvaluation {
  id             String   @id @default(cuid())
  tenantId String @default("")
  pacienteId     String
  professionalId String
  date           String
  evaluations    String
  totalEvaluations Int  @default(0)
  averageScore   Float  @default(0)
  maxScore       Float  @default(0)
  minScore       Float  @default(0)
  createdAt      DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  profissional User     @relation(fields: [professionalId], references: [id])

  @@index([tenantId])
}

model InterventionPlan {
  id             String   @id @default(cuid())
  tenantId String @default("")
  pacienteId     String
  professionalId String
  date           String
  step1          String?
  step2          String?
  step3          String?
  sessionCount   Int      @default(0)
  sessionValue   String?
  totalValue     String?
  frequency      String?
  duration       String?
  status         String   @default("RASCUNHO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  profissional User     @relation(fields: [professionalId], references: [id])

  @@index([tenantId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  tenantId String @default("")
  senderId       String
  senderName     String
  senderRole     String   @default("RESPONSAVEL")
  message        String
  pacienteId     String
  readByStaff    Boolean  @default(false)
  readByGuardian Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([tenantId])
}

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
}

model SessionDiary {
  id              String   @id @default(cuid())
  tenantId String @default("")
  pacienteId      String
  sessionNumber   Int
  date            String
  professionalId  String?
  professionalName String?
  objective       String?
  instruments     String?
  studentBehavior String?
  activities      String?
  observations    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([tenantId])
}

model FrequencySheet {
  id              String   @id @default(cuid())
  tenantId String @default("")
  pacienteId      String
  date            String
  entryTime       String?
  exitTime        String?
  activities      String?
  instruments     String?
  observations    String?
  guardianSignature String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([tenantId])
}

model InterventionDocument {
  id              String   @id @default(cuid())
  tenantId String @default("")
  pacienteId      String
  professionalId  String?
  professionalName String?
  step1           String?
  step2           String?
  step3           String?
  sessionCount    Int      @default(0)
  sessionValue    String?
  totalValue      String?
  frequency       String?
  duration        String?
  status          String   @default("RASCUNHO")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([tenantId])
}

model ConsentLog {
  id           String   @id @default(cuid())
  tenantId String @default("")
  patientId    String
  responsibleId String?
  consentType  String
  status       String
  details      String?
  ipAddress    String?
  recordedAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  paciente Paciente? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
}

model Nfse {
  id              String   @id @default(cuid())
  tenantId String @default("")
  number          Int      @unique
  patientId       String
  professionalId  String
  description     String
  value           Float
  taxRate         Float    @default(0)
  taxValue        Float    @default(0)
  totalValue      Float
  status          String   @default("PENDENTE")
  issuedAt        DateTime?
  cancelledAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  paciente     Paciente @relation(fields: [patientId], references: [id])
  professional User     @relation(fields: [professionalId], references: [id])

  @@index([tenantId])
}

model WaitingRoom {
  id            String    @id @default(cuid())
  tenantId String @default("")
  patientId     String
  appointmentId String?
  status        String    @default("AGUARDANDO")
  checkInAt     DateTime  @default(now())
  calledAt      DateTime?
  sessionAt     DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  paciente Paciente? @relation(fields: [patientId], references: [id])

  @@index([tenantId])
}
model Plan {
  id              String   @id @default(cuid())
  code            String   @unique // TRIAL | BASICO | PRO
  name            String
  priceCents      Int      @default(0)
  maxPacientes    Int
  maxProfissionais Int
  features        String   @default("[]")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planCode          String   @default("TRIAL")
  status            String   @default("TRIAL") // TRIAL | ATIVA | PENDENTE | CANCELADA | BLOQUEADA
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd  DateTime
  provider          String?  // asaas | mercadopago | mock
  providerId        String?  // id da assinatura/cobrança no provedor
  providerCustomerId String? // id do customer no provedor (asaas)
  providerPaymentId String?  // id da cobrança atual no provedor
  pixCopiaECola     String?
  pixQrImage        String?  // QR code em base64 (imagem png)
  pixExpiresAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
