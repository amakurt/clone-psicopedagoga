# =========================================================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO (HOSTINGER VPS KVM 2)
# =========================================================================

# Porta da API do Backend
PORT=3000
NODE_ENV=production

# Conexão com o Banco de Dados PostgreSQL (Container Docker Local)
DATABASE_URL="postgresql://edupsych:SUA_SENHA_FORTE_DO_BANCO@127.0.0.1:5432/edupsych_prod?schema=public"

# Segurança e Sessão (Gere chaves aleatórias seguras com: openssl rand -hex 32)
JWT_SECRET="GERAR_NOVO_TOKEN_SECRETO_HEX_32"
SESSION_SECRET="GERAR_OUTRO_TOKEN_SECRETO_HEX_32"

# Domínios de Produção (Ajuste para o seu domínio real)
FRONTEND_URL="https://app.seudominio.com.br"
GOOGLE_CALLBACK_URL="https://api.seudominio.com.br/api/auth/google/callback"

# Google OAuth (Opcional para login com Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Envio de E-mails Transacionais (Gmail ou SMTP da Hostinger)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app-do-google"
SMTP_FROM="EduPsych Pro <seu-email@gmail.com>"
ALLOW_INSECURE_EMAIL="false"

# Inteligência Artificial (Google Gemini) para os chats do WhatsApp
GEMINI_API_KEY="AIzaSyA646XaLOiAIHmna3Mal4sI1Yb-Gz2OS7o"

# Gateway WhatsApp (Evolution API v2 - Container Docker Local na porta 8080)
EVOLUTION_API_URL="http://127.0.0.1:8080"
EVOLUTION_API_KEY="edupsych_evolution_master_key_2026"
