DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET="psicopedagoga-secret-key-2026"

# Session Configuration
SESSION_SECRET="psicopedagoga-session-secret-2026"

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Frontend URL for OAuth redirect
FRONTEND_URL="http://localhost:4200"

# SMTP (email de verificação/recuperação) - exemplo Gmail
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seuemail@gmail.com"
SMTP_PASS="sua-senha-de-app-16-caracteres"
SMTP_FROM="EduPsych Pro <seuemail@gmail.com>"

# Domínios fictícios que NÃO devem ser enviados por e-mail real (evita bounce)
# SMTP_FAKE_DOMAINS="email.com,exemplo.com,test.com"
ALLOW_INSECURE_EMAIL="true"

# Asaas - Pix recorrente (assinaturas mensais)
# Conta em https://www.asaas.com (BR) - API Key em Integrações > Chave de API (começa com $aact_)
# Sandbox: https://sandbox.asaas.com - mesma estrutura, dados fictícios
# ASAAS_ENV="sandbox"   # sandbox (padrão) | prod
# ASAAS_API_KEY=""
# ASAAS_WEBHOOK_TOKEN=""  # authToken configurado no Webhook do Asaas (validado no header asaas-access-token)

# Token de desenvolvimento do webhook (usado apenas sem ASAAS_API_KEY, modo mock)
# BILLING_WEBHOOK_TOKEN="dev-webhook-token"